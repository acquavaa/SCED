local function getFrontURL(cardMetadataID, searchCode)
	local cardImageUrls = CARD_IMAGE_URLS[cardMetadataID]
	if not cardImageUrls then return nil end
	if not cardImageUrls[searchCode] then return nil end
	-- log("Image URL: " .. (cardImageUrls[searchCode] or ""))
	return cardImageUrls[searchCode]
end

function onLoad()
  self.createButton({
    click_function = "onClick_Process",
    function_owner = self,
    label          = "Update card",
    tooltip        = "Replace the Level 0 card with the appropriate upgraded card",
	position       = { x = 0, y = 0.12, z = -0.8 },
    font_size      = 200,
    width          = 1200,
    height         = 300,
    scale          = { 0.5, 1, 0.5 }
  })
end

function onClick_Process()
	local foundSheets = false
	--loop through the cards on the card searcher object
	for _, card in ipairs(SearchLib.onObject(self, "isCard")) do
		local metadata = JSON.decode(card.getGMNotes()) or {}
		if metadata.type == "UpgradeSheet" then
			foundSheets = true
			for _, baseCard in ipairs(SearchLib.onObject(self, "isCard")) do
				local searchCode = ""
				local metadata2 = JSON.decode(baseCard.getGMNotes()) or {}
				if metadata.id == (metadata2.id .. "-c") then
					log("Found Card ID: " .. metadata2.id)
					for i, customizations in ipairs(metadata2.customizations) do
						if card.call("isUpgradeActive", i) then
							searchCode = searchCode .. string.char(string.byte("a") + i - 1)
						end
					end
					log("searchCode: " .. searchCode)
					
					--Change the front URL
					FrontURL = getFrontURL(metadata2.id, searchCode)
					local baseCardData = baseCard.getData()
					local deckId, customDeckData = next(baseCardData.CustomDeck)
					customDeckData.NumWidth = 1
					customDeckData.NumHeight = 1
					if FrontURL ~= nil then
						customDeckData.FaceURL = FrontURL
						-- log("New URL: " .. customDeckData.FaceURL)
					end
					-- add the custom deck data to the card data
					baseCardData.CustomDeck = { [deckId] = customDeckData }

					-- destroy the original and respawn it
					baseCard.destruct()
					spawnObjectData({data = baseCardData})
				end
			end
		end
	end

	if not foundSheets then
		printToAll("No upgrade sheets found on object.", "Yellow")
	end
end

